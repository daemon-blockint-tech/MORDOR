        >>> extract_command_types("npm install")
        ['npm install']
        >>> extract_command_types("cd /path && python -m pytest tests/")
        ['cd', 'python -m pytest']
        >>> extract_command_types("python -m pip install package")
        ['python -m pip']
        >>> extract_command_types("python -c 'print(1)'")
        ['python -c']
