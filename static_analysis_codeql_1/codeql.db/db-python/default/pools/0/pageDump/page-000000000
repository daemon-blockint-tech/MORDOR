  core.setFailed(
    `Version extraction returned empty values. SDK: "${sdkVersion}", CLI pin: "${cliPin}". ` +
    'Check that libs/deepagents/pyproject.toml and libs/cli/pyproject.toml have the expected format.'
  );
  return;
}

