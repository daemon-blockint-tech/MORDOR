if ! [[ "$INPUT_TIMEOUT" =~ ^[0-9]+$ ]] || [ "$INPUT_TIMEOUT" -eq 0 ]; then
  echo "::error::Invalid timeout '${INPUT_TIMEOUT}' — must be a positive integer (minutes)"
