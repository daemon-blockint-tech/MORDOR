# MORDOR API Keys
ANTHROPIC_API_KEY=sk-ant-...
SHODAN_API_KEY=...
OPENROUTER_API_KEY=sk-or-v1-...

# Default LLM models (OpenRouter)
GANDALF_MODEL=openai/gpt-4o-mini
SARUMAN_MODEL=anthropic/claude-opus-4

# IDA API Key for binary analysis
IDA_API_KEY=hrp-1-...

# ---------------------------------------------------------------------------
# Optional coding-agent integrations
# ---------------------------------------------------------------------------

# OpenCode SDK integration (https://opencode.ai/docs/sdk/)
# Enable by setting OPENCODE_ENABLED=true and running the opencode server.
OPENCODE_ENABLED=false
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_TIMEOUT=10

# Claude Agent SDK integration (https://github.com/anthropics/claude-code)
# Enable by setting CLAUDE_AGENT_ENABLED=true and installing anthropic-agent-sdk.
CLAUDE_AGENT_ENABLED=false
CLAUDE_AGENT_MODEL=

# Pay CLI — programmable money toolchain (https://pay.loremlabs.xyz)
PAY_BIN_PATH=/path/to/pay